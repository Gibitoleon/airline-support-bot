
## SERVER PORT
# Internal port on which the Node.js backend listens inside its container.
# Keep this value at 3000. Configure the host port in the root Docker Compose environment if necessary.
PORT=3000

## DATABASE CONFIGURATION
# 1. Create a project at https://supabase.com/
# 2. Navigate to Project Settings -> Database.
# 3. Obtain the PostgreSQL connection string.
# 4. Replace the placeholders with your database credentials.
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@host:port/database

## REDIS CONFIGURATION
# 1. Create an account with a cloud Redis provider.
# 2. Create a Redis database or instance.
# 3. Obtain the hostname, port and password from the provider dashboard.
# 4. Enter the supplied connection details below.
# 5. Ensure TLS is configured in the application if required by your provider.
REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_PASSWORD=your_redis_password

## SESSION CONFIGURATION
# Generate a secure random secret using: openssl rand -base64 32
# Replace the placeholder with the generated value.
SESSION_SECRET=replace_with_generated_secret

## MAIL CONFIGURATION
# Gmail SMTP configuration.
# 1. Use a Gmail account to send system emails.
# 2. Enable 2-Step Verification on the Google account.
# 3. Generate an App Password at https://myaccount.google.com/apppasswords
# 4. Use the Gmail address as MAIL_USER and MAIL_FROM.
# 5. Use the generated App Password as MAIL_PASS (not your normal Gmail password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail_address@gmail.com
MAIL_PASS=your_google_app_password
MAIL_FROM=your_gmail_address@gmail.com

## RAG-PYTHON SERVICE
# Internal Docker Compose URL of the Python RAG service.
# Keep this value unless the service name or port changes.
RAG_SERVICE_URL=http://rag-service:5001

## FRONTEND URL
# URL of the frontend application accessible from the host machine.
# Keep the default value unless the frontend port mapping in docker-compose.yml changes.
FRONTEND_URL=http://localhost:5173

## NODE_ENV
# Execution environment for the Node.js application.
NODE_ENV=development

## INITIAL STAFF ACCOUNTS
# Email addresses for the initial staff accounts created by the seeder.
INITIAL_STAFF_1_EMAIL=
INITIAL_STAFF_2_EMAIL=

## INITIAL ADMINISTRATOR ACCOUNT
# Email address for the initial knowledge base administrator account.
INITIAL_ADMIN_EMAIL=

## INITIAL ACCOUNT PASSWORD
# Shared initial password assigned to all three accounts created by the users seeder.
# Change this password after the initial accounts have been created.
INITIAL_ACCOUNT_PASSWORD=replace_with_a_strong_password
