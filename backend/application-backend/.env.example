## SERVER PORT
PORT=5000

## DATABASE CONFIGURATION
DATABASE_URL=postgresql://username:password@localhost:5432/airline_support_db

## REDIS CONFIGURATION
REDIS_PASSWORD=example_redis_password
REDIS_HOST=redis.example.com
REDIS_PORT=6379

## SESSION CONFIGURATION
SESSION_SECRET=change_this_to_a_long_random_secret

## MAIL CONFIGURATION
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=example@example.com
MAIL_PASS=example_mail_password
MAIL_FROM=no-reply@example.com

## RAG-PYTHON SERVICE
RAG_SERVICE_URL=http://localhost:5001

## FRONTEND URL
FRONTEND_URL=http://localhost:3000

### NODE_ENV
NODE_ENV=development

## INITIAL STAFF ACCOUNTS
INITIAL_STAFF_1_EMAIL=
INITIAL_STAFF_1_PASSWORD=f

INITIAL_STAFF_2_EMAIL=
INITIAL_STAFF_2_PASSWORD=

## INITIAL ADMINISTRATOR ACCOUNT
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

## INITIAL ACCOUNT PASSWORD
INITIAL_ACCOUNT_PASSWORD=