## SERVER PORT
PORT=5000

## DATABASE CONFIGURATION
DATABASE_URL=postgresql://username:password@localhost:5432/airline_support_db

## REDIS CONFIGURATION
REDIS_PASSWORD=example_redis_password
REDIS_HOST=redis.example.com
REDIS_PORT=6379

## SESSION CONFIGURATION
SESSION_SECRET=change_this_to_a_long_random_secret

## MAIL CONFIGURATION
