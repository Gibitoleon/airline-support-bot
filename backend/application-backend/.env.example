MAIL_PORT=587
MAIL_USER=example@example.com
MAIL_PASS=example_mail_password
MAIL_FROM=no-reply@example.com

## RAG-PYTHON SERVICE
RAG_SERVICE_URL=http://localhost:5001

## FRONTEND URL
FRONTEND_URL=http://localhost:3000